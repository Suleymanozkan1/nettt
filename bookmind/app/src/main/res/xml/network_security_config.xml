<?xml version="1.0" encoding="utf-8"?>
<!--
  Plain HTTP is permitted only so the app can reach a free model on the user's own computer (Ollama, llama.cpp,
  LM Studio serve http on the local network, and Android cannot whitelist IP ranges here). Both HTTP clients are
  restricted in code instead: LocalEndpoint accepts only private-network addresses for the local model, and
  BackendConfig requires https:// for the optional sync backend.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" xmlns:tools="http://schemas.android.com/tools" />
</network-security-config>
