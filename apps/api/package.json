{
  "name": "@stage/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "prisma generate && tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "realtime": "tsx --env-file-if-exists=.env src/realtime-server.ts"
  },
  "dependencies": {
    "@colyseus/core": "0.16.26",
    "@colyseus/redis-driver": "~0.16.1",
    "@colyseus/redis-presence": "~0.16.4",
    "@colyseus/schema": "^3.0.76",
    "@colyseus/ws-transport": "~0.16.5",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "6.19.3",
    "@stage/shared": "workspace:*",
    "fast-jwt": "^6.3.3",
    "fastify": "^5.6.1",
    "ioredis": "^5.8.2",
    "prisma": "6.19.3",
    "prom-client": "^15.1.3",
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "colyseus.js": "~0.16.22",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
