DATABASE_URL=postgresql://stage:stage@localhost:5432/stagestack_dev
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,capacitor://localhost,https://localhost
PORT=3000
# Global reward circuit breaker: total credits granted in 24h above this trips the breaker
DAILY_CREDIT_LIABILITY_LIMIT=5000000
AUTH_RATE_LIMIT_PER_MIN=10
GUEST_ACCOUNTS_PER_IP_PER_DAY=20
# Set to true only behind a trusted reverse proxy
TRUST_PROXY=false
RATE_LIMIT_PER_MIN=120
RUN_RATE_LIMIT_PER_MIN=30
# METRICS_TOKEN=at-least-16-chars (required for /metrics in production)
